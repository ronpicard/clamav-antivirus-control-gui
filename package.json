{
  "name": "clamav-antivirus-control-gui",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ron Picard",
  "description": "Desktop UI for ClamAV configuration (Tauri + Rust)",
  "scripts": {
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "render-icon": "node scripts/render-app-icon.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "build:client": "npm run build --prefix client",
    "prepare:server": "npm ci --prefix server --omit=dev",
    "sync-server-resources": "node scripts/sync-server-resources.mjs",
    "fetch-node-sidecar": "node scripts/fetch-node-sidecar.mjs",
    "stage-tauri-bundle": "npm run fetch-node-sidecar && npm run prepare:server && npm run build:client && npm run sync-server-resources",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "sharp": "^0.34.5"
  }
}
